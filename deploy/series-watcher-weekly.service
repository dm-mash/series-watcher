[Unit]
Description=Series watcher: weekly digest
After=network-online.target

[Service]
Type=oneshot
User=${USER}
WorkingDirectory=${PROJECT_DIR}
ExecStart=${PROJECT_DIR}/.venv/bin/series-watcher digest --days 7 --recommend --send
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target

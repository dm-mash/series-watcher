[Unit]
Description=Series watcher: poll schedule
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=${USER}
WorkingDirectory=${PROJECT_DIR}
ExecStart=${PROJECT_DIR}/.venv/bin/series-watcher run
Restart=on-failure
RestartSec=300
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target

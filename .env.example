# Зона показа времени. В базе лежит UTC, часовой пояс нужен только для вывода.
TZ=Europe/Moscow

# Путь к SQLite. Каталог data/ создаётся при первом запуске.
DB_PATH=data/series-watcher.db

# HTTP
HTTP_TIMEOUT=15
HTTP_RETRIES=3

# TVmaze: публичный API, ключ не нужен. Лимит — 20 запросов на 10 секунд,
# поэтому по умолчанию берём 18 запросов на окно в 10 секунд.
TVMAZE_BASE_URL=https://api.tvmaze.com
TVMAZE_CACHE_TTL=21600

# Насколько глубоко смотрим назад за уже вышедшими эпизодами. Окно нужно,
# чтобы добавление сериала с историей не обернулось потоком из сотен сообщений.
NOTIFY_LOOKBACK_HOURS=72

# TMDB: режиссёры и сценаристы для рекомендаций. Без ключа рекомендации
# остаются на уровне «авторство из TVmaze + жанры».
TMDB_API_KEY=

# Telegram: тихий режим. Пустая переменная выключает его совсем.
QUIET_HOURS=23-8

# JustWatch: где сериал сейчас стримят. Без ключа отдаём ссылку на TVmaze.
JUSTWATCH_API_KEY=
JUSTWATCH_COUNTRY=RU

# Свой источник «где смотреть»: JSON с id сериала TVmaze и ссылками.
CUSTOM_SOURCES_PATH=data/where_to_watch.json

# Telegram: уведомления и разговорный слой. Без токена работает только CLI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM: разбор фразы в намерение, объяснение рекомендаций. Любой
# OpenAI-совместимый /chat/completions. Без него бот отвечает по правилам.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=700